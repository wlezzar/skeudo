{
  "name": "remark-skeudo",
  "version": "0.1.0",
  "description": "A remark plugin that renders Skeudo sketches in Markdown and MDX: pseudocode with every outside effect tagged, and data models drawn as tables with a story of how their rows change.",
  "keywords": ["skeudo", "remark-plugin", "remark", "unified", "mdx", "markdown", "pseudocode", "code-review", "data-model"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlezzar/skeudo.git",
    "directory": "packages/remark"
  },
  "bugs": "https://github.com/wlezzar/skeudo/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "types": "./dist/index.d.ts"
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node ../../scripts/build-library.mts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@skeudo/core": "workspace:*",
    "@skeudo/html": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
