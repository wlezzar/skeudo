{
  "name": "skeudo",
  "version": "0.1.0",
  "description": "Checks Skeudo sketches and renders them as standalone HTML pages: pseudocode for code review with every outside effect tagged, and data models drawn as tables with a story of how their rows change.",
  "keywords": ["skeudo", "cli", "pseudocode", "code-review", "data-model", "markdown"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlezzar/skeudo.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/wlezzar/skeudo/issues",
  "type": "module",
  "bin": {
    "skeudo": "./dist/skeudo.js"
  },
  "files": [
    "dist/skeudo.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mts",
    "prepack": "node build.mts",
    "package": "pnpm pack --out skeudo.tgz"
  },
  "devDependencies": {
    "@skeudo/core": "workspace:*",
    "@skeudo/html": "workspace:*",
    "esbuild": "0.28.2",
    "markdown-it": "^15.0.3",
    "markdown-it-skeudo": "workspace:*"
  }
}
