{
  "name": "skeudo-vscode",
  "displayName": "Skeudo",
  "description": "Highlights sketches in .skeudo files and Markdown fences, and renders them in the Markdown preview: pseudocode for code review, with every outside effect tagged.",
  "version": "0.0.0",
  "private": true,
  "publisher": "wlezzar",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1f2330",
    "theme": "dark"
  },
  "preview": true,
  "homepage": "https://skeudo.dev",
  "bugs": "https://github.com/wlezzar/skeudo/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlezzar/skeudo",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "skeudo",
    "markdown",
    "pseudocode",
    "code review",
    "data model",
    "documentation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "files": [
    "dist/extension.js",
    "dist/preview.js",
    "dist/skeudo.css",
    "dist/skeudo.tmLanguage.json",
    "dist/markdown-skeudo.tmLanguage.json",
    "language-configuration.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./dist/skeudo.css"
    ],
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "languages": [
      {
        "id": "skeudo",
        "aliases": [
          "Skeudo"
        ],
        "extensions": [
          ".skeudo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skeudo",
        "scopeName": "source.skeudo",
        "path": "./dist/skeudo.tmLanguage.json"
      },
      {
        "scopeName": "markdown.skeudo.codeblock",
        "path": "./dist/markdown-skeudo.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.skeudo": "skeudo"
        }
      }
    ],
    "configuration": {
      "title": "Skeudo",
      "properties": {
        "skeudo.labelKinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "untrusted",
            "secret"
          ],
          "markdownDescription": "Tag kinds whose value labels a variable, as `::untrusted:body` labels `body`. Every later use of a labeled variable is marked."
        },
        "skeudo.kindColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "CSS colors for tag kinds, such as `{ \"todo\": \"#8b5cf6\" }`. They override the default colors."
        },
        "skeudo.repositories": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine",
          "markdownDescription": "Local copies of repositories, for sketches that name theirs with `::repo`, such as `{ \"github.com/org/shop\": \"~/code/shop\" }`. Not needed for a repository you have opened in VS Code since installing the extension."
        },
        "skeudo.gitHosts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket"
            ]
          },
          "default": {},
          "markdownDescription": "Other GitHub, GitLab or Bitbucket servers, such as `{ \"git.example.com\": \"gitlab\" }`, so sketches of their repositories link to them when there is no local copy."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mts",
    "package": "node build.mts && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@skeudo/core": "workspace:*",
    "@skeudo/html": "workspace:*",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "markdown-it": "^15.0.3",
    "markdown-it-skeudo": "workspace:*",
    "ovsx": "1.3.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
