{
  "name": "skeudo-vscode",
  "displayName": "Skeudo",
  "description": "Highlights sketches in .skeudo files and Markdown fences, and renders them in the Markdown preview: pseudocode for code review, with every outside effect tagged.",
  "version": "0.0.1",
  "private": true,
  "publisher": "skeudo",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlezzar/skeudo",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "pseudocode",
    "code review"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "files": [
    "dist/extension.js",
    "dist/preview.js",
    "dist/sketch.css",
    "dist/skeudo.tmLanguage.json",
    "dist/markdown-skeudo.tmLanguage.json",
    "language-configuration.json",
    "README.md"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./dist/sketch.css"
    ],
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "languages": [
      {
        "id": "skeudo",
        "aliases": [
          "Skeudo"
        ],
        "extensions": [
          ".skeudo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skeudo",
        "scopeName": "source.skeudo",
        "path": "./dist/skeudo.tmLanguage.json"
      },
      {
        "scopeName": "markdown.skeudo.codeblock",
        "path": "./dist/markdown-skeudo.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.skeudo": "skeudo"
        }
      }
    ],
    "configuration": {
      "title": "Skeudo",
      "properties": {
        "skeudo.labelKinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "untrusted",
            "secret"
          ],
          "markdownDescription": "Tag kinds whose value labels a variable, as `::untrusted:body` labels `body`. Every later use of a labeled variable is marked."
        },
        "skeudo.kindColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "CSS colors for tag kinds, such as `{ \"todo\": \"#8b5cf6\" }`. They override the default colors."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mts",
    "package": "node build.mts && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@skeudo/core": "workspace:*",
    "@skeudo/html": "workspace:*",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "markdown-it": "^15.0.3",
    "markdown-it-skeudo": "workspace:*",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
